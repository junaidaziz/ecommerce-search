{
  "name": "product-search-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "prisma migrate dev",
    "format": "prettier --write .",
    "test": "jest",
    "type-check": "tsc --noEmit",
